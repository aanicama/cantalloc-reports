	<subDataset name="Participantes" uuid="0f12768a-23f1-4a19-ac70-ede03927304c">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySqlDataAdapter.jrdax"/>
		<parameter name="id_registro" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT
        rap.id_registro,
        per.id_personal,
        per.dni,
        per.nombre_personal,
        per.apellido_personal,
        per.cargo_personal
    FROM registro_actividades_personal rap
    LEFT JOIN personal per ON rap.id_personal = per.id_personal
    WHERE rap.id_registro = $P{id_registro}]]>
		</queryString>
		<field name="id_registro" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="id_registro"/>
			<property name="com.jaspersoft.studio.field.label" value="id_registro"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="registro_actividades_personal"/>
			<fieldDescription><![CDATA[Identificación de la reunión asociada al detalle de personal asistente]]></fieldDescription>
		</field>
		<field name="id_personal" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="id_personal"/>
			<property name="com.jaspersoft.studio.field.label" value="id_personal"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="personal"/>
		</field>
		<field name="dni" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="dni"/>
			<property name="com.jaspersoft.studio.field.label" value="dni"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="personal"/>
		</field>
		<field name="nombre_personal" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombre_personal"/>
			<property name="com.jaspersoft.studio.field.label" value="nombre_personal"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="personal"/>
		</field>
		<field name="apellido_personal" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="apellido_personal"/>
			<property name="com.jaspersoft.studio.field.label" value="apellido_personal"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="personal"/>
		</field>
		<field name="cargo_personal" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="cargo_personal"/>
			<property name="com.jaspersoft.studio.field.label" value="cargo_personal"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="personal"/>
		</field>
	</subDataset>
	<parameter name="id_registro" class="java.lang.Integer">
		<parameterDescription><![CDATA[Valor del registro de la charla]]></parameterDescription>
	</parameter>
	<queryString language="SQL">
		<![CDATA[WITH personal_data AS (
    SELECT
        rap.id_registro,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'id_personal', per.id_personal,
                'dni', per.dni,
                'nombre_personal', per.nombre_personal,
                'apellido_personal', per.apellido_personal,
                'cargo_personal', per.cargo_personal
            )
        ) AS personal_info
    FROM registro_actividades_personal rap
    LEFT JOIN personal per ON rap.id_personal = per.id_personal
    WHERE rap.id_registro = $P{id_registro}
    GROUP BY rap.id_registro
),
medidas_data AS (
    SELECT
        rad.id_registro,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'id_medida', rad.id_medida,
                'descripcion_medida', mc.descripcion_medida,
                'checked', rad.checked,
                'id_peligro', rad.id_peligro,
                'descripcion_peligro', p.descripcion_peligro,
                'clasificacion', p.clasificacion
            )
        ) AS medidas_info
    FROM registro_actividades_detalles rad
    LEFT JOIN medidas_control mc ON rad.id_medida = mc.id_medida
    LEFT JOIN peligros p ON rad.id_peligro = p.id_peligro
    WHERE rad.id_registro = $P{id_registro}
    GROUP BY rad.id_registro
)

SELECT
    ra.id_area,
    a.descripcion_area,
    ra.id_contratista,
    c.nombre_contratista,
    ra.permiso_trabajo,
    ra.id_personal_responsable,
    pr.nombre_personal,
    pr.correo,
    i.id_imagenes,
    i.imagen,
    pd.personal_info,
    md.medidas_info
FROM registro_actividades ra
INNER JOIN area a ON ra.id_area = a.id_area
INNER JOIN contratista c ON ra.id_contratista = c.id_contratista
INNER JOIN personal_responsable pr ON ra.id_personal_responsable = pr.id_personal_responsable
LEFT JOIN imagenes i ON ra.id_registro = i.id_registro
LEFT JOIN personal_data pd ON ra.id_registro = pd.id_registro
LEFT JOIN medidas_data md ON ra.id_registro = md.id_registro
WHERE ra.id_registro = $P{id_registro}]]>
	</queryString>
