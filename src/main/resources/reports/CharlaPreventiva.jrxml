	<subDataset name="Dataset1" uuid="ced18dd0-dad5-4efc-b250-cecc6d2122a5">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySqlDataAdapter.jrdax"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="479"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="521"/>
		<parameter name="id_registro" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT
    mc.id_medida,
    mc.descripcion_medida,
    p.descripcion_peligro,
    COALESCE(rad.id_registro, '') AS id_registro,  -- Si no existe, dejar vacío
 	COALESCE(rad.checked, 0) AS checked,
    COALESCE(rad.id_peligro, '') AS id_peligro     -- Si no existe, dejar vacío
FROM medidas_control mc
inner join u969339482_CANTALLOC.peligros p on mc.id_peligro = p.id_peligro
LEFT JOIN u969339482_CANTALLOC.registro_actividades_detalles rad
    ON mc.id_medida = rad.id_medida
    AND rad.id_registro =  $P{id_registro}   -- Filtramos solo el registro específico
where p.clasificacion = 1
ORDER BY mc.id_medida]]>
		</queryString>
		<field name="id_medida" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="id_medida"/>
			<property name="com.jaspersoft.studio.field.label" value="id_medida"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="medidas_control"/>
		</field>
		<field name="descripcion_medida" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="descripcion_medida"/>
			<property name="com.jaspersoft.studio.field.label" value="descripcion_medida"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="medidas_control"/>
		</field>
		<field name="descripcion_peligro" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="descripcion_peligro"/>
			<property name="com.jaspersoft.studio.field.label" value="descripcion_peligro"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="peligros"/>
		</field>
		<field name="id_registro" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="id_registro"/>
			<property name="com.jaspersoft.studio.field.label" value="id_registro"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="registro_actividades_detalles"/>
		</field>
		<field name="checked" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="checked"/>
			<property name="com.jaspersoft.studio.field.label" value="checked"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="registro_actividades_detalles"/>
			<fieldDescription><![CDATA[Para indicar si la medida de control ha sido marcada o no]]></fieldDescription>
		</field>
		<field name="id_peligro" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="id_peligro"/>
			<property name="com.jaspersoft.studio.field.label" value="id_peligro"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="registro_actividades_detalles"/>
			<fieldDescription><![CDATA[idenficador de peligro relacionado con la medida de control]]></fieldDescription>
		</field>
	</subDataset>
	<subDataset name="Dataset2" uuid="9a0a9cd4-44d4-4ad4-91e8-d67a3b4d2e84">
